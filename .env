# Perfil da aplicação: "local" (padrão) ou "dev" (docker)
# local → cache em memória
# dev   → cache Redis
APP_PROFILE=local

# TTL do cache em segundos (padrão: 60)
CACHE_TTL=60

# URL do Redis — usado apenas no perfil "dev"
# Em Docker: redis://redis:6379
# Local com Redis manual: redis://localhost:6379
REDIS_URL=redis://localhost:6379
